# ─── prisma/migrations ─────────────────────────────────────────────────────
# Run this on Railway/Render BEFORE the app starts:
#   npx prisma migrate deploy
#
# On first deploy (if no migration history), run:
#   npx prisma db push

# ─── All environment variables needed in Railway / Render ──────────────────
# DATABASE_URL       = postgresql://user:pass@host:5432/dbname   (auto-set by Railway Postgres plugin)
# JWT_SECRET         = any long random string (min 32 chars)
# GROQ_API_KEY       = gsk_...
# GROQ_MODEL         = llama-3.3-70b-versatile
# SMTP_USER          = your-gmail@gmail.com   (optional, for email)
# SMTP_PASS          = gmail-app-password      (optional)
# SMTP_FROM          = "RMS Platform <your-gmail@gmail.com>"
# FRONTEND_URL       = https://your-app.vercel.app
# NODE_ENV           = production
# PORT               = (Railway sets this automatically — leave blank)
