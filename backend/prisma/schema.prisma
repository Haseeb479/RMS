generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  website     String?
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  jobs       Job[]
  candidates Candidate[]
  resumes    Resume[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("recruiter")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  location     String?
  type         String   @default("full-time")   // full-time | part-time | contract | remote
  salary       String?
  requirements String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status       String   @default("draft")        // draft | published | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
}

model Candidate {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  location    String?
  resume      String?  // File path
  skills      String?  // JSON string of skills array
  experience  Int?     // Years of experience
  salary      Int?     // Expected salary
  notes       String?
  status      String   @default("new") // new, contacted, shortlisted, rejected, hired
  score       Float?   // Candidate match score (0-100)
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  resumes      Resume[]
}

model Application {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      String    @default("applied")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Resume {
  id            String   @id @default(cuid())
  fileName      String
  filePath      String
  fileSize      Int      // in bytes
  mimeType      String   // application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document
  extractedText String?  @db.Text // Extracted text from file
  
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([candidateId])
  @@index([companyId])
}