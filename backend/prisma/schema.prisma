generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  website     String?
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  jobs       Job[]
  candidates Candidate[]
  resumes    Resume[]
  interviews Interview[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("recruiter")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  location     String?
  type         String   @default("full-time")   // full-time | part-time | contract | remote
  salary       String?
  requirements String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status       String   @default("draft")        // draft | published | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  interviews   Interview[]
}

model Candidate {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  location    String?
  resume      String?  // File path
  skills      String?  // JSON string of skills array
  experience  Int?     // Years of experience
  salary      Int?     // Expected salary
  notes       String?
  status      String   @default("new") // new, contacted, shortlisted, rejected, hired
  score       Float?   // Candidate match score (0-100)
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  resumes      Resume[]
  interviews   Interview[]
}

model Application {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      String    @default("applied")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  interviews  Interview[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
}

model Resume {
  id            String   @id @default(cuid())
  fileName      String
  filePath      String
  fileSize      Int      // in bytes
  mimeType      String   // application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document
  extractedText String?  @db.Text // Extracted text from file
  
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([candidateId])
  @@index([companyId])
}

model Interview {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  title           String   // e.g. "Technical Coding Interview"
  type            String   @default("technical") // screening | technical | behavioral | hr | final
  scheduledAt     DateTime
  duration        Int      @default(60) // minutes
  location        String?  // Google Meet link / Zoom link / Location
  interviewerName String?
  interviewerEmail String?
  status          String   @default("scheduled") // scheduled | completed | cancelled | rescheduled
  
  // Feedback & Evaluation
  feedback        String?  @db.Text
  rating          Int?     // 1 - 5 scale
  recommendation  String?  // strong_hire | hire | reconsider | reject

  // Email Scheduler Tracking
  inviteEmailSent   Boolean  @default(false)  // Interview invite sent on creation
  reminder24hSent   Boolean  @default(false)  // 24-hour reminder sent
  reminder1hSent    Boolean  @default(false)  // 1-hour reminder sent
  cancelEmailSent   Boolean  @default(false)  // Cancellation email sent

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([scheduledAt])
}